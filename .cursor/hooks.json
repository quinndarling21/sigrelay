{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/shell_policy.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/protect_tests.py",
        "matcher": "Delete",
        "timeout": 10,
        "failClosed": true
      }
    ]
  }
}
